+#[test]
+fn prompt_context_error_is_actionable_without_changing_delivery_evidence() {
+    use crate::fault::{BridgeFault, code, details};
+    assert_eq!(
+        code("not sent: context_changed: original input boundary not ready"),
+        "context_changed"
